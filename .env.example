ENVIRONMENT=development
# ============================================================================
# NEW SUPABASE API KEYS (STAND 2026)
# ============================================================================
# 1. Öffentlicher Schlüssel (Safe für den Browser dank RLS)
NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=supabase_anon_test

# 2. Geheimer Server-Schlüssel (Bypasst RLS, darf NIEMALS das NEXT_PUBLIC_ Präfix haben!)
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase_test

# ============================================================================
# VORSCHAU-SPERRE (A2 aus AP-2)
# ============================================================================
# Schaltet die Passwortabfrage vor der gesamten Seite ein. Nur der Wert `true`
# aktiviert sie; jeder andere Wert und "nicht gesetzt" bedeuten AUS.
#
# Das ist bewusst so herum: Die öffentliche Seite soll ohne Zutun normal
# laufen. Der Preis ist, dass eine Vorschauumgebung ohne diese Variable
# öffentlich ist — ohne Fehlermeldung. Vor der ersten Vorschau also setzen.
#
# Ausgenommen von der Sperre sind die Anmelderoute selbst und der
# Stripe-Webhook (maschinelle Aufrufer haben kein Cookie).
PREVIEW_PROTECTION_ENABLED=false

# Passwort für die Vorschau. Fehlt es, während die Sperre aktiv ist, lässt die
# Anmelderoute niemanden durch (Antwort 500) — die Seite bleibt zu, statt sich
# versehentlich zu öffnen.
PREVIEW_PASSWORD=

# Schlüssel, mit dem das Vorschau-Cookie signiert wird. Ohne ihn bleibt die
# Seite bei aktiver Sperre geschlossen (Antwort 500) — bewusst, damit ein
# fehlender Wert die Vorschau nicht versehentlich öffnet.
PREVIEW_TOKEN_SECRET=

# ============================================================================
# FALLCODE (Issue #153)
# ============================================================================
# Pepper für den Suchschlüssel: case_code_hash = HMAC-SHA-256(Pepper, Code).
# Mindestens 32 Zeichen. Ohne diesen Wert findet die Anwendung KEINEN Fall
# mehr — sie scheitert dann bewusst laut, statt stillschweigend nichts zu
# finden.
#
# Er gehört ins Secret-Management der Infrastruktur, NICHT in die Datenbank:
# Genau darauf beruht der Schutz. Und er ist ein anderes Secret als das der
# Ratenbegrenzung (#136) — ein Leck des einen darf das andere nicht mitreißen.
#
# Erzeugen: openssl rand -base64 48
#
# ⚠️ Wird dieser Wert geändert, passt kein gespeicherter Suchschlüssel mehr.
# Alle Fälle wären ausgesperrt, und aus dem Hash lässt sich nichts
# zurückrechnen. Eine Rotation braucht denselben Weg wie der Backfill — und
# den Klartext, den es dann nicht mehr gibt.
CASE_CODE_PEPPER=nur_fuer_die_entwicklung_mindestens_32_zeichen

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
STRIPE_SECRET_KEY=sk_test_123456789abcdefg
STRIPE_PUBLISHABLE_KEY=pk_test_123456789abcdefg
STRIPE_WEBHOOK_SECRET=whsec_123456789abcdefg
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================================================
# UPSTASH REDIS (Edge-Middleware: Rate-Limit + öffentlicher Cache)
# Optional — fehlen die Werte, läuft das Rate-Limit auf einem In-Memory-
# Fallback und der Edge-Cache wird übersprungen (kein harter Fehler).
# Werte aus der Upstash-Konsole (REST-API, nicht die TCP-URL).
# ============================================================================
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# ============================================================================

# ============================================================================
# PDF / PUPPETEER (optional)
# Nur nötig, wenn ein eigener Chromium-/Chrome-Pfad erzwungen werden soll.
# Auf Vercel NICHT setzen — dort wird automatisch @sparticuz/chromium genutzt.
# Lokal (macOS/Linux) wird der System-Browser erkannt; dieser Wert überschreibt.
# ============================================================================
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# ============================================================================

# ============================================================================
# ISR REVALIDATE (Presseportal — optional)
# Secret für den On-Demand-Revalidate-Endpunkt. Ein Supabase-Webhook auf der
# posts-Tabelle ruft /api/revalidate mit diesem Secret. Ohne Wert ist der
# Endpunkt deaktiviert; die stündliche ISR-Baseline greift trotzdem.
# ============================================================================
REVALIDATE_SECRET=ein_langes_zufaelliges_secret
# ============================================================================

# ==============================================================================
# WEB ANALYTICS (Umami — optional)
# Ohne NEXT_PUBLIC_UMAMI_WEBSITE_ID bleibt Analytics vollständig inaktiv:
# es wird kein Skript geladen und keine Verbindung aufgebaut. Kein harter Fehler.
#
# Die Erfassung startet ausschließlich nach Einwilligung im Cookie-Banner
# (Kategorie „Analyse & Statistik"). Umami setzt keine Cookies.
#
# Website-ID aus dem Umami-Dashboard (Settings → Websites).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
#
# Skript-URL. Voreinstellung ist die EU-Region der Umami-Cloud; nur setzen,
# wenn selbst gehostet wird oder die globale Region genutzt werden soll.
# Ein abweichender Host muss zusätzlich in die CSP (next.config.ts).
# NEXT_PUBLIC_UMAMI_SRC=https://eu.umami.is/script.js
# ==============================================================================
