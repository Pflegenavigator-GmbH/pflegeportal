ENVIRONMENT=development
# ============================================================================
# NEW SUPABASE API KEYS (STAND 2026)
# ============================================================================
# 1. Öffentlicher Schlüssel (Safe für den Browser dank RLS)
NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=supabase_anon_test

# 2. Geheimer Server-Schlüssel (Bypasst RLS, darf NIEMALS das NEXT_PUBLIC_ Präfix haben!)
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase_test

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
STRIPE_SECRET_KEY=sk_test_123456789abcdefg
STRIPE_PUBLISHABLE_KEY=pk_test_123456789abcdefg
STRIPE_WEBHOOK_SECRET=whsec_123456789abcdefg
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================================================
# BREVO CONFIGURATION
# ============================================================================
BREVO_API_KEY=brevo_test_123456789abcdefg
# ============================================================================
# ============================================================================
# UPSTASH REDIS (Edge-Middleware: Rate-Limit + öffentlicher Cache)
# Optional — fehlen die Werte, läuft das Rate-Limit auf einem In-Memory-
# Fallback und der Edge-Cache wird übersprungen (kein harter Fehler).
# Werte aus der Upstash-Konsole (REST-API, nicht die TCP-URL).
# ============================================================================
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# ============================================================================

# ============================================================================
# PDF / PUPPETEER (optional)
# Nur nötig, wenn ein eigener Chromium-/Chrome-Pfad erzwungen werden soll.
# Auf Vercel NICHT setzen — dort wird automatisch @sparticuz/chromium genutzt.
# Lokal (macOS/Linux) wird der System-Browser erkannt; dieser Wert überschreibt.
# ============================================================================
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# ============================================================================

# ============================================================================
# ISR REVALIDATE (Presseportal — optional)
# Secret für den On-Demand-Revalidate-Endpunkt. Ein Supabase-Webhook auf der
# posts-Tabelle ruft /api/revalidate mit diesem Secret. Ohne Wert ist der
# Endpunkt deaktiviert; die stündliche ISR-Baseline greift trotzdem.
# ============================================================================
REVALIDATE_SECRET=ein_langes_zufaelliges_secret
# ============================================================================
