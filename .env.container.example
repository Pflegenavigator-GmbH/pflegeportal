# Laufzeit-Umgebung des Containers (#177).
#
# Kopieren nach .env.container und füllen. Die Datei gehört NICHT ins
# Repository und nicht ins Abbild — sie wird beim Start eingehängt
# (ADR-0003: Geheimnisse nur zur Laufzeit).
#
# Ausnahme sind die Werte mit dem Präfix NEXT_PUBLIC_: Die schreibt Next beim
# Bauen ins Browser-Bündel. Sie stehen hier trotzdem, weil die Compose-Datei
# sie als Build-Argumente weiterreicht.

ENVIRONMENT=production

# --- Supabase ---------------------------------------------------------------
# Öffentlich, durch RLS getragen (Bauzeit):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-seitig, umgeht RLS (Laufzeit):
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Fallcode ---------------------------------------------------------------
# Ohne diesen Wert findet die Anwendung keinen Fall mehr (#153). Er gehört ins
# Secret-Management, und er darf nach einer Wiederherstellung nicht fehlen:
# Aus dem Hash lässt sich nichts zurückrechnen.
CASE_CODE_PEPPER=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Nach einem Wechsel der Domain im Stripe-Dashboard nachziehen, sonst laufen
# Zahlungsbestätigungen ins Leere.
STRIPE_WEBHOOK_SECRET=

# --- Adresse ----------------------------------------------------------------
DOMAIN=pflegenavigator.example
NEXT_PUBLIC_URL=https://pflegenavigator.example

# --- Vorschau-Sperre --------------------------------------------------------
# Nur der Wert `true` aktiviert sie. In Produktion aus.
PREVIEW_PROTECTION_ENABLED=false
PREVIEW_PASSWORD=
PREVIEW_TOKEN_SECRET=

# --- PDF --------------------------------------------------------------------
# Im Abbild ist Chromium ein Systempaket; der Pfad steht bereits im Dockerfile.
# Hier nur nötig, wenn ein anderer Browser genutzt werden soll.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
#
# Gleichzeitige PDF-Erzeugungen. Auf 2 GB RAM bleibt es bei 1 — jede Erzeugung
# startet eine eigene Chromium-Instanz.
PDF_MAX_PARALLEL=1
# PDF_MAX_WARTEPLAETZE=4
# PDF_WARTEZEIT_MS=30000

# --- Ratenbegrenzung --------------------------------------------------------
# Solange die Anwendung den Upstash-Client nutzt (#136), stehen hier dessen
# Werte — oder nichts. Nichts bedeutet: prozesslokale Begrenzung, kein Cache,
# und vor allem kein Aufruf gegen einen Dienst, den es nicht mehr gibt (#176).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sonstiges (optional) ---------------------------------------------------
# REVALIDATE_SECRET=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=
